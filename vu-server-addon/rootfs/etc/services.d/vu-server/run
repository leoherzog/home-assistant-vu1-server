#!/usr/bin/with-contenv bashio
cd /opt/vu-server || exit 1
# Tornado logs failed requests with their query strings, so redact keys before they reach the Supervisor log.
# Upstream never reopens a failed serial port, so restart it after repeated EIO.
# awk ignores SIGTERM so the server's shutdown lines still reach the log during container stop.
venv/bin/python server.py --logging "$(bashio::config log_level)" 2>&1 |
  (trap '' TERM; exec awk '{ gsub(/key=[^&\047 )]*/, "key=REDACTED"); sub(/key: b[\047"].*/, "key: REDACTED"); print; fflush() } /\[Errno 5\]/ && ++n == 3 { system("pkill -f \"[s]erver.py\"") }')
